extends ../layouts/main

block content
  .page-header
    h2
      i.bi.bi-truck.me-2
      | Suppliers & Credit
    if user.role !== 'sales_attendant'
      a.btn.btn-warning.fw-bold(href="/suppliers/add")
        i.bi.bi-plus.me-1
        | Add Supplier

  .card.dark-card
    .card-body.p-0
      .table-responsive
        table.table.table-dark.table-hover.mb-0
          thead
            tr
              th Supplier
              th Phone
              th Credit Limit
              th Current Debt
              th Status
              th Actions
          tbody
            if suppliers.length
              each s in suppliers
                tr
                  td= s.name
                  td= s.phone
                  td= parseInt(s.credit_limit).toLocaleString()
                  td(class=s.current_balance > 0 ? 'text-danger fw-bold' : 'text-success')
                    | UGX #{parseInt(s.current_balance).toLocaleString()}
                  td
                    if s.current_balance <= 0
                      span.badge.bg-success Cleared
                    else if s.current_balance < s.credit_limit
                      span.badge.bg-warning.text-dark Partial
                    else
                      span.badge.bg-danger Over Limit
                  td
                    .d-flex.gap-1
                      a.btn.btn-sm.btn-warning(href=`/suppliers/${s.id}/credit`)
                        i.bi.bi-credit-card.me-1
                        | Credit
                      if user.role !== 'sales_attendant'
                        a.btn.btn-sm.btn-outline-warning(href=`/suppliers/edit/${s.id}`)
                          i.bi.bi-pencil
            else
              tr
                td.text-center.text-muted(colspan="6") No suppliers yet
