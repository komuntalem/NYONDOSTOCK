nav.navbar.top-navbar
  .d-flex.align-items-center.gap-3
    button#sidebarToggle.btn.btn-link.text-dark.p-0(type="button")
      i.bi.bi-list.fs-4
    a.navbar-brand.fw-bold(href="/dashboard")
      span.text-dark NYO
      span.text-dark NDO
      span.text-dark STOCK
  .d-flex.align-items-center.gap-3
    .dropdown
      button.btn.btn-outline-dark.btn-sm.dropdown-toggle(data-bs-toggle="dropdown")
        i.bi.bi-person-circle.me-1
        = user.name
      ul.dropdown-menu.dropdown-menu-end.dropdown-dark
        li
          span.dropdown-item-text.text-dark.small= user.role.replace('_',' ').toUpperCase()
        li: hr.dropdown-divider
        li
          a.dropdown-item(href="/logout")
            i.bi.bi-box-arrow-right.me-2
            | Logout
